# DO NOT put real values in this file — it is committed to git.
# Copy it to `.env` (gitignored) and put real keys there instead:
#   cp .env.example .env

# --- Spotify (search uses client-credentials; playback needs a logged-in user) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Anthropic (line-by-line translation, batched per song+language) ---
ANTHROPIC_API_KEY=

# --- Database ---
DATABASE_URL=postgresql+psycopg://dhun:dhun@postgres:5432/dhun

# --- NextAuth (frontend Spotify login for playback) ---
# Must be 127.0.0.1, not localhost — Spotify's redirect URI no longer accepts
# "localhost" as a hostname, and it must match what you browse to exactly
# (localhost and 127.0.0.1 are different origins, so cookies won't carry over
# if these don't match).
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://127.0.0.1:3000

# --- Frontend -> Backend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
